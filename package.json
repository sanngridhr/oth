{
  "name": "oth",
  "version": "0.0.1",
  "description": "Org to HTML parser",
  "keywords": [
    "org",
    "markup",
    "html"
  ],
  "homepage": "https://github.com/sanngridhr/oth#readme",
  "bugs": {
    "url": "https://github.com/sanngridhr/oth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanngridhr/oth.git"
  },
  "license": "Beerware",
  "author": "Sanngriðr",
  "type": "module",
  "main": "src/oth.ts",
  "types": "./dist/oth.d.ts",
  "exports": {
    ".": {
      "types": "./dist/oth.d.ts",
      "import": "./dist/oth.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "format": "prettier . --check --cache --cache-location .prettiercache",
    "lint": "eslint . --cache"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "<6.1.0",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "ts-pattern": "^5.9.0"
  }
}
